{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Filesystem": {
    "AllowedRoots": [ "Documents", "Desktop", "Workspace" ]
  },
  "DocumentReaders": {
    "MaxFileSizeBytes": 10485760,
    "MaxExtractedCharacters": 1000000,
    "MaxRows": 10000,
    "MaxColumns": 200,
    "TimeoutSeconds": 30,
    "AllowPartialResults": true
  },
  "Knowledge": {
    "MaxItemCharacters": 2000,
    "ChunkOverlapCharacters": 200,
    "MaxItemsPerDocument": 5000,
    "IncludeMetadataItems": true
  },
  "Memory": {
    "MaxDocuments": 10000,
    "MaxItemsPerDocument": 5000,
    "MaxQueryResults": 1000
  },
  "Search": {
    "MaxQueryLength": 2000,
    "MaxTokens": 100,
    "MaxCandidateDocuments": 5000,
    "MaxResults": 100
  },
  "VectorIndex": {
    "MaxRecords": 100000,
    "MaxQueryResults": 1000,
    "MaxMetadataEntries": 50
  },
  "SemanticSearch": {
    "MaxCandidates": 10000,
    "DefaultTopK": 10,
    "MaxTopK": 100,
    "CandidatePageSize": 500
  },
  "HybridSearch": {
    "LexicalWeight": 0.4,
    "SemanticWeight": 0.6,
    "DefaultTopK": 10,
    "MaxTopK": 100,
    "CandidateMultiplier": 3
  },
  "Context": {
    "DefaultMaxTokens": 6000,
    "MaxAllowedTokens": 12000,
    "DefaultMaxItems": 20,
    "MaxAllowedItems": 100,
    "CharactersPerTokenEstimate": 4.0
  },
  "Rag": {
    "MaxQueryCharacters": 4000,
    "DefaultTopK": 10,
    "MaxTopK": 50,
    "DefaultContextTokens": 6000,
    "MaxContextTokens": 12000,
    "RequireCitations": true
  },
  "ConversationContext": {
    "DefaultMaxTokens": 3000,
    "MaxAllowedTokens": 8000,
    "DefaultMaxTurns": 20,
    "MaxAllowedTurns": 100,
    "CharactersPerTokenEstimate": 4.0
  },
  "Kai": {
    "MaxMessageCharacters": 4000,
    "DefaultMode": "Auto",
    "AllowAutoRagFallbackToChat": true,
    "AllowPlannerInAuto": false
  },
  "Embeddings": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "embeddinggemma",
    "TimeoutSeconds": 60,
    "MaxInputCharacters": 8000,
    "MaxBatchSize": 32,
    "ExpectedDimensions": 768,
    "AllowPartialBatchResults": false
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:8b",
    "TimeoutSeconds": 120,
    "SystemPrompt": "Eres Kai, el asistente personal local de KernelOS. Responde en español de forma clara y útil."
  }
}
